# CommonHome Canvas — example configuration.
#
# EVERY VARIABLE IN THIS FILE IS OPTIONAL. Canvas boots and renders with none
# of them set; that is a deliberate property, not an accident. Copy this file
# to `.env` only when you want to turn something on:
#
#     cp .env.example .env
#
# Never commit your `.env`. The values here are placeholders, not credentials.

# --- Serving -----------------------------------------------------------------

# Port the server listens on inside the container. Change the published port in
# docker-compose.yml (CANVAS_HOST_PORT) rather than this, unless you know why.
# Default: 4174
#CANVAS_PORT=4174

# Interface to bind. 0.0.0.0 is correct for a container; loopback-only would
# make it unreachable from the host.
# Default: 0.0.0.0
#CANVAS_HOST=0.0.0.0

# The address people actually type to reach Canvas, used to build absolute
# links (share URLs, a QR code for a tablet). It cannot be inferred reliably
# behind a proxy, and inferring it from the Host header is a known source of
# link-poisoning bugs, so it is configured. Unset simply disables absolute
# links.
# Default: unset
#CANVAS_BASE_URL=https://canvas.example.org

# Where Canvas writes persistent state. Inside the container this is a volume.
# Default: /data
#CANVAS_DATA_DIR=/data

# Comma-separated hostnames permitted in the Host header. Loopback and the host
# of CANVAS_BASE_URL are always allowed, so you only need this when reaching
# Canvas by a LAN address or extra name. A wrong value shows as a 403.
# Default: 127.0.0.1,localhost,[::1]
#CANVAS_ALLOWED_HOSTS=canvas.example.org,192.0.2.10

# --- Home Assistant (optional) -----------------------------------------------
#
# Supplies weather, the next calendar event and who is home. Canvas works
# without it — those elements are simply omitted rather than shown empty.
# BOTH url and token are required to enable it; setting only one is reported as
# a warning and leaves the integration off.
#
# The token is a long-lived access token from your Home Assistant profile page.
# It stays in this process and is never sent to the browser.

#HOMEASSISTANT_URL=http://homeassistant.example.lan:8123
#HOMEASSISTANT_TOKEN=replace-with-your-long-lived-access-token

# Entity ids are specific to your house and have no sensible default — a
# weather entity is named after someone's home. Each one you leave unset is an
# element Canvas simply does not draw. Find them in Developer Tools → States.
#CANVAS_WEATHER_ENTITY=weather.your_entity_here
#CANVAS_CALENDAR_ENTITY=calendar.your_entity_here

# Comma-separated. Anyone listed shows on the display when they are home.
#CANVAS_PERSON_ENTITIES=person.someone,person.someone_else

# --- Background photos (optional) --------------------------------------------
#
# A free Unsplash demo application key. Without it Canvas renders on a flat
# colour, which is a visual downgrade, not a failure. The key is used
# server-side only; the browser receives an image URL and its attribution.
# Get one at https://unsplash.com/developers

#UNSPLASH_ACCESS_KEY=replace-with-your-unsplash-access-key

# Unsplash topic id to draw from. The default is a wallpaper collection —
# calm landscapes suited to a wall display.
# Default: bo8jQKTaE0Y
#CANVAS_PHOTO_TOPIC=bo8jQKTaE0Y

# Identifies this installation in the attribution links the photo provider's
# API guidelines require. Part of crediting photographers, not branding.
# Default: commonhome_canvas
#CANVAS_APP_NAME=commonhome_canvas

# --- Presentation ------------------------------------------------------------

# Usage analytics. Local only; nothing is sent anywhere. Set to `off` to stop
# recording it at all.
# Default: on
#CANVAS_ANALYTICS=off

# Locale for dates, times and number formatting.
# Default: en-US
#CANVAS_LOCALE=en-GB

# Time zone for the display. Unset means "use the container's zone", which is
# right if you have given it the host's /etc/localtime.
# Default: unset (host default)
#CANVAS_TIMEZONE=Europe/London
